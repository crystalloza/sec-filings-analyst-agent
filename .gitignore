# Secrets — never commit these
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data and outputs (often large, regenerable)
data/raw/
data/cache/
data/warehouse.duckdb*
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store

# Baseline dev runs are throwaway; measured runs (eval/runs/measured_*) are committed as evidence
eval/runs/dev_*.jsonl

# Judge dev runs are throwaway; judge runs on measured answers are committed as evidence
eval/judge_runs/dev_*.jsonl
data/index/
eval/runs/agent_dev*.jsonl
.coverage
htmlcov/
